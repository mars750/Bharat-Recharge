# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Application Configuration
PORT=3000
NODE_ENV="development"

# Discount Configuration (Calculated strictly on backend)
DEFAULT_DISCOUNT_INR=5

# Payment Gateway Configuration
# When MOCK_PAYMENT_MODE=true, interactive bank/UPI simulators and webhooks are active
MOCK_PAYMENT_MODE=true
PAYMENT_WEBHOOK_SECRET="whsec_bharat_recharge_live_secure_key_2026"
UPI_MERCHANT_VPA="rolexmars37-1@oksbi"
UPI_MERCHANT_NAME="Rolex Mars"

# Recharge Provider Configuration
# When MOCK_RECHARGE_MODE=true, MockRechargeProvider simulates instant telecom operator APIs
MOCK_RECHARGE_MODE=true
RECHARGE_API_KEY="mock_recharge_key_sandbox"
RECHARGE_API_URL="https://api.rechargelogic.in/v1"

# Admin Authentication
ADMIN_SECRET_KEY="bharat_super_admin_jwt_secret_token_999"
ADMIN_DEFAULT_EMAIL="admin@recharge.in"
ADMIN_DEFAULT_PASSWORD="Admin@123"
